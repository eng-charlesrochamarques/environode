# Root environment example for local development.
# Copy to .env only when needed and never commit real secrets.

NODE_ENV=development

API_PORT=4000
WEB_PORT=5173

MONGODB_URI=mongodb://localhost:27017/environode
# Use "embedded" for local development without Docker, or "external" with MONGODB_URI.
DATABASE_MODE=embedded
MONGODB_VERSION=7.0.14

JWT_SECRET=replace-with-a-local-development-secret
JWT_EXPIRES_IN=1h

CORS_ORIGIN=http://localhost:5173

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
AI_SUMMARIES_ENABLED=false

# Fictional local device credential. Replace per device outside development.
DEMO_DEVICE_KEY=env-demo-device-key-change-me

